__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/
build/
dist/
.DS_Store

# Next.js build output — frontend/.gitignore already covers this inside
# frontend/, but a `next build` accidentally run from the repo root
# (wrong cwd) creates one here too; ignore it at both levels.
.next/

*.txt
Proposal.pdf

# The blanket *.txt rule above would otherwise also hide oculus's own
# small hand-curated bundled wordlists (oculus/data/wordlists/*.txt —
# admin.txt, usernames.txt, etc.), which genuinely need to be committed;
# they're project assets, not scratch/downloaded files.
!oculus/data/wordlists/*.txt

# Wordlists installed on demand from github.com/danielmiessler/SecLists
# via the web UI's "SecLists (GitHub)" picker tab (oculus/seclists_remote.py)
# — downloaded per checkout, not meant to be committed.
oculus/data/wordlists_downloaded/

# hydra writes this resume-state file into the process's cwd (the project
# root, when run via the web UI's backend) on a real run — local scan
# state, never meant to be committed.
hydra.restore

# Sample report generated while manually testing the report feature —
# a demo artifact, not a project asset.
demo_report.md
