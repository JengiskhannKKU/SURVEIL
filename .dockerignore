# Only the root Dockerfile's own build context needs trimming here —
# frontend/ has its own .dockerignore for its own build context. These
# still matter because the root build context (everything docker sends
# to the daemon before .dockerignore filtering elsewhere applies) would
# otherwise include frontend's node_modules/.next wholesale.
frontend/node_modules
frontend/.next
frontend/out

# Wordlists installed on demand (see oculus/seclists_remote.py) and
# HISTORY.md — neither is needed inside the image.
oculus/data/wordlists_downloaded
HISTORY.md
